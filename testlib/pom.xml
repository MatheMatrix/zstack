    <build>
        <plugins>
            <!-- 标准Java编译器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <release>${project.java.version}</release>
                    <debug>true</debug>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- GMavenPlus 用于编译Groovy代码 -->
            <!-- 注意：generateStubs 必须在 process-sources phase 运行，确保 Java 编译器能看到 Groovy 类的 stub -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>4.2.1</version>
                <executions>
                    <!-- 在 process-sources phase 生成 Groovy stub，供 Java 编译器使用 -->
                    <execution>
                        <id>generate-stubs</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>generateStubs</goal>
                        </goals>
                    </execution>
                    <!-- 在 compile phase 编译 Groovy 代码 -->
                    <execution>
                        <id>compile-groovy</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <!-- 在 process-test-sources phase 生成测试 Groovy stub -->
                    <execution>
                        <id>generate-test-stubs</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>generateTestStubs</goal>
                        </goals>
                    </execution>
                    <!-- 在 test-compile phase 编译测试 Groovy 代码 -->
                    <execution>
                        <id>compile-test-groovy</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <groovyVersion>${groovy.version}</groovyVersion>
                    <targetBytecode>${project.java.version}</targetBytecode>
                    <!-- 明确包含 src/main/java 与 src/main/groovy，避免 Groovy 源放在 java 目录时被漏编译 -->
                    <sources>
                        <fileset>
                            <directory>${project.basedir}/src/main/java</directory>
                            <includes>
                                <include>**/*.groovy</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>${project.basedir}/src/main/groovy</directory>
                            <includes>
                                <include>**/*.groovy</include>
                            </includes>
                        </fileset>
                    </sources>
                    <testSources>
                        <fileset>
                            <directory>${project.basedir}/src/test/java</directory>
                            <includes>
                                <include>**/*.groovy</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>${project.basedir}/src/test/groovy</directory>
                            <includes>
                                <include>**/*.groovy</include>
                            </includes>
                        </fileset>
                    </testSources>
                </configuration>
            </plugin>
        </plugins>
    </build>
