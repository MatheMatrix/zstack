<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:zstack="http://zstack.org/schema/zstack"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://zstack.org/schema/zstack
       http://zstack.org/schema/zstack/plugin.xsd">

    <bean id="VmLocalVolumeCachePoolManager" class="org.zstack.storage.localvolumecache.VmLocalVolumeCachePoolManagerImpl">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
            <zstack:extension interface="org.zstack.header.Service"/>
            <zstack:extension interface="org.zstack.header.localVolumeCache.VmLocalVolumeCachePoolManager"/>
        </zstack:plugin>
    </bean>

    <bean id="VmLocalVolumeCacheManager" class="org.zstack.storage.localvolumecache.VmLocalVolumeCacheManagerImpl">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
            <zstack:extension interface="org.zstack.header.Service"/>
            <zstack:extension interface="org.zstack.header.localVolumeCache.VmLocalVolumeCacheManager"/>
            <zstack:extension interface="org.zstack.kvm.KVMStartVmExtensionPoint"/>
            <zstack:extension interface="org.zstack.kvm.KVMAttachVolumeExtensionPoint"/>
        </zstack:plugin>
    </bean>

    <bean id="CachePoolHostAllocatorFilter" class="org.zstack.storage.localvolumecache.CachePoolHostAllocatorFilter">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.allocator.HostAllocatorFilterExtensionPoint"/>
        </zstack:plugin>
    </bean>

    <bean id="VmLocalVolumeCacheApiInterceptor" class="org.zstack.storage.localvolumecache.VmLocalVolumeCacheApiInterceptor">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.apimediator.ApiMessageInterceptor"/>
            <zstack:extension interface="org.zstack.header.apimediator.GlobalApiMessageInterceptor"/>
        </zstack:plugin>
    </bean>

</beans>
